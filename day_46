//Problem statement
//Nisha is learning about virtual functions and virtual destructors in c++.She creates an abstract base class Shape with a pure virtual method area() and a virtual destructor.Two concrete derived classes are created: Circle (uses radius) and Rectangle(uses width and height).A base class pointer is used to create the appropriate derived object dynamically.The area is computed via the virtual function, printed, and the object is deleted.The virtual destructor ensures the correct destructor is called.
//The shape of an object type is either "Circle" or "Rectangle".
//Formula: circle area =3.14 * radius * radius
//Rectangle area =width*height

#include <iostream>
using namespace std;

// Abstract Base Class
class Shape {
public:
    virtual double area() = 0;

    virtual ~Shape() {
        cout << "Shape destructor called" << endl;
    }
};

// Derived Class: Circle
class Circle : public Shape {
    double radius;

public:
    Circle(double r) {
        radius = r;
    }

    double area() {
        return 3.14 * radius * radius;
    }

    ~Circle() {
        cout << "Circle destructor called" << endl;
    }
};

// Derived Class: Rectangle
class Rectangle : public Shape {
    double width, height;

public:
    Rectangle(double w, double h) {
        width = w;
        height = h;
    }

    double area() {
        return width * height;
    }

    ~Rectangle() {
        cout << "Rectangle destructor called" << endl;
    }
};

int main() {
    Shape* ptr;
    int choice;

    cout << "1. Circle" << endl;
    cout << "2. Rectangle" << endl;
    cout << "Enter your choice: ";
    cin >> choice;

    if (choice == 1) {
        double radius;
        cout << "Enter radius: ";
        cin >> radius;

        ptr = new Circle(radius);

        cout << "Area of Circle: " << ptr->area() << endl;
    }
    else if (choice == 2) {
        double width, height;

        cout << "Enter width and height: ";
        cin >> width >> height;

        ptr = new Rectangle(width, height);

        cout << "Area of Rectangle: " << ptr->area() << endl;
    }
    else {
        cout << "Invalid choice";
        return 0;
    }

    delete ptr;

    return 0;
}
