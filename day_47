  1.”Design an abstract Shape class with a pure virtual area() function.Create Circle and Rectangle classes.Input the shape of name,then two numbers.For circle,the second number is 0;for rectangle ,they are width and height .Display area to two decimal places and show destructor messages when deleting through Shape.”

Sol:
#include <iostream>
#include <iomanip>
using namespace std;
class Shape {
public:
    virtual double area() = 0;

    virtual ~Shape() {
        cout << "Shape destructor called" << endl;
    }
};
class Circle : public Shape {
    double r;

public:
    Circle(double radius) {
        r = radius;
    }

    double area() override {
        return 3.14 * r * r;
    }

    ~Circle() {
        cout << "Circle destructor called" << endl;
    }
};
class Rectangle : public Shape {
    double w, h;

public:
    Rectangle(double width, double height) {
        w = width;
        h = height;
    }

    double area() override {
        return w * h;
    }

    ~Rectangle() {
        cout << "Rectangle destructor called" << endl;
    }
};

int main() {
    string name;
    double a, b;

    Shape* s = nullptr;

    cout << "Enter shape name: ";
    cin >> name;

    cout << "Enter two numbers: ";
    cin >> a >> b;

    if (name == "Circle" || name == "circle") {
        s = new Circle(a);
    }
    else if (name == "Rectangle" || name == "rectangle") {
        s = new Rectangle(a, b);
    }
    else {
        cout << "Invalid shape";
        return 0;
    }

    cout << fixed << setprecision(2);

    cout << "Area of " << name << " = " << s->area() << endl;

    delete s;

    return 0;
}
