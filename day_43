//Function overloading
Function overloading means having multiple functions with the same name but different parameter lists.

#include <iostream>
using namespace std;

class Calculator {
public:
    int add(int a, int b) {
        return a + b;
    }

    int add(int a, int b, int c) {
        return a + b + c;
    }

    double add(double a, double b) {
        return a + b;
    }
};

int main() {
    Calculator c;

    cout << c.add(10, 20) << endl;
    cout << c.add(10, 20, 30) << endl;
    cout << c.add(2.5, 3.5);

    return 0;
}
//output
30
60
6
//Call by value
Call by value: A copy of the variable is passed. Changes do not affect the original.
void change(int x) {
    x = 100;
}
//Call by address
Call by address: The address of a variable is passed using a pointer.
void change(int *x) {
    *x = 100;
}
//Call by reference
Call by reference: An alias of the original variable is passed.
void change(int &x) {
    x = 100;
}
#include <iostream>
using namespace std;

void value(int x) {
    x = 100;
}

void address(int *x) {
    *x = 200;
}

void reference(int &x) {
    x = 300;
}

int main() {
    int a = 10, b = 10, c = 10;

    value(a);
    address(&b);
    reference(c);

    cout << a << endl;
    cout << b << endl;
    cout << c << endl;

    return 0;
}

//output
10
200
300
