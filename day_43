//D. Copy constructor
A copy constructor creates a new object using an existing object of the same class.
#include <iostream>
using namespace std;

class Student {
public:
    int marks;

    Student(int m) {
        marks = m;
    }

    Student(const Student &obj) {
        marks = obj.marks;
    }

    void display() {
        cout << marks << endl;
    }
};

int main() {
    Student s1(90);

    Student s2(s1);

    s1.display();
    s2.display();

    return 0;
}
//output
90
90
//What is a destructor?
A destructor is a special member function that is automatically called when an object is destroyed.

It is used to release resources, such as dynamically allocated memory or other resources owned by the object.
Rules:
- Its name is the class name preceded by ~.
- It has no return type.
- It takes no arguments.
- A class can have only one destructor.
#include <iostream>
using namespace std;

class Student {
public:
    Student() {
        cout << "Constructor called" << endl;
    }

    ~Student() {
        cout << "Destructor called" << endl;
    }
};

int main() {
    Student s1;

    cout << "Inside main" << endl;

    return 0;
}
//output
Constructor called
Inside main
Destructor called

