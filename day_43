//What is operator overloading?
Operator overloading means giving a special meaning to an existing operator when it is used with objects of a class.
#include <iostream>
using namespace std;

class Number {
public:
    int x;

    Number(int a) {
        x = a;
    }

    void operator++() {
        ++x;
    }

    void display() {
        cout << x;
    }
};

int main() {
    Number n(10);

    ++n;

    n.display();

    return 0;
}
//output
11
//Binary operator overloading
Binary operators work with two operands.
//Adding two objects
#include <iostream>
using namespace std;

class Number {
public:
    int x;

    Number(int a) {
        x = a;
    }

    Number operator+(Number obj) {
        Number temp(0);

        temp.x = x + obj.x;

        return temp;
    }

    void display() {
        cout << x;
    }
};

int main() {
    Number n1(10);
    Number n2(20);

    Number n3 = n1 + n2;

    n3.display();

    return 0;
}
//output
30
