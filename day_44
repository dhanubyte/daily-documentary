//If age is less than age then that is eligible and allowed...if age>18 not allowed

#include <iostream>
using namespace std;

int main() {
    int age;
    cout << "Age: ";
    cin >> age;

    try {
        if (age > 18) {
            throw age;
        }
        else if (age < 18) {
            cout << "Allowed: " << age;
        }
        else {
            cout << "Age is exactly 18";
        }
    }
    catch (int x) {
        cout << "Not allowed: " << x;
    }

    cout << "\nEnd of the program...";

    return 0;
}
//output
